
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum TechnicianApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceCategory {
  ELECTRICITY
  PLUMBING
  GAS
  LOCKSMITH
  MASONRY
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  technician        Technician?
  serviceRequests   ServiceRequest[] @relation("RequestClient")
  cancelledRequests ServiceRequest[] @relation("RequestCancelledBy")
}

model Technician {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @unique @db.Uuid
  approvalStatus TechnicianApprovalStatus @default(PENDING)

  user            User                     @relation(fields: [userId], references: [id])
  specialties     TechnicianSpecialty[]
  neighborhoods   TechnicianNeighborhood[]
  serviceRequests ServiceRequest[]
  offers          ServiceOffer[]
}

model TechnicianSpecialty {
  technicianId String          @db.Uuid
  category     ServiceCategory
  licenseNumber String?

  technician Technician @relation(fields: [technicianId], references: [id])

  @@id([technicianId, category])
}

model Neighborhood {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  technicians TechnicianNeighborhood[]
  requests    ServiceRequest[]
}

model TechnicianNeighborhood {
  technicianId   String @db.Uuid
  neighborhoodId String @db.Uuid

  technician   Technician   @relation(fields: [technicianId], references: [id])
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])

  @@id([technicianId, neighborhoodId])
}

model ServiceRequest {
  id             String               @id @default(uuid()) @db.Uuid
  clientId       String               @db.Uuid
  technicianId   String?              @db.Uuid
  neighborhoodId String               @db.Uuid
  category       ServiceCategory
  addressLine    String
  description    String
  status         ServiceRequestStatus @default(PENDING)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  acceptedAt     DateTime?            @db.Timestamptz(3)
  completedAt    DateTime?            @db.Timestamptz(3)
  cancelledAt    DateTime?            @db.Timestamptz(3)
  cancelledById  String?              @db.Uuid

  client       User          @relation("RequestClient", fields: [clientId], references: [id])
  cancelledBy  User?         @relation("RequestCancelledBy", fields: [cancelledById], references: [id])
  technician   Technician?   @relation(fields: [technicianId], references: [id])
  neighborhood Neighborhood  @relation(fields: [neighborhoodId], references: [id])
  offers       ServiceOffer[]
}

model ServiceOffer {
  id           String             @id @default(uuid()) @db.Uuid
  requestId    String             @db.Uuid
  technicianId String             @db.Uuid
  status       ServiceOfferStatus @default(PENDING)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime           @db.Timestamptz(3)

  request    ServiceRequest @relation(fields: [requestId], references: [id])
  technician Technician     @relation(fields: [technicianId], references: [id])

  @@index([requestId, technicianId, status])
  @@index([technicianId, status, expiresAt])
}
