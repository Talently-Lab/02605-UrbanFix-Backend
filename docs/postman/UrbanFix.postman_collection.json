          ]
        },
        {
          "name": "Perfil propio",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/usuarios/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin campos sensibles', () => {",
                  "  const visit = value => { if (value && typeof value === 'object') for (const [key, item] of Object.entries(value)) { pm.expect(['passwordHash', 'password', 'licenseNumber']).not.to.include(key); visit(item); } };",
                  "  visit(pm.response.json());",
                  "});",
                  "pm.test('Perfil propio y rol esperado', () => { const data=pm.response.json(); pm.expect(data.role).to.eql(pm.environment.get('expectedRole')); pm.expect(data).to.have.all.keys('id','name','email','phone','role','accountStatus','technician','lastLoginAt','isTestUser'); if (data.role==='ADMIN') pm.expect(data.phone).to.eql(null); if (data.role==='TECHNICIAN') pm.expect(data.technician).to.have.all.keys('id','approvalStatus'); });"
                ]
