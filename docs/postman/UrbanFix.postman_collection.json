{
  "info": {
    "name": "UrbanFix Sprint 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo preproduction verificada. No ejecutada remotamente. Login, registro y PATCH escriben datos. Escrituras deshabilitadas por defecto. Login antes de Perfil; seleccionar requests y rol conscientemente, no ejecutar toda la coleccion como flujo de alta."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.environment.get('baseUrl');",
          "const approved = pm.environment.get('approvedBaseUrl');",
          "const target = pm.environment.get('target');",
          "const url = pm.variables.replaceIn(pm.request.url.toString());",
          "if (!base || !/^https:\\/\\/[^/?#@\\\\\\s]+$/.test(base) || base !== approved || target !== 'preproduction' || !url.startsWith(base + '/')) pm.execution.skipRequest();",
          "if (!['GET', 'HEAD', 'OPTIONS'].includes(pm.request.method) && pm.environment.get('allowWrites') !== 'true') pm.execution.skipRequest();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Consultas",
      "item": [
        {
          "name": "Health basico",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin campos sensibles', () => {",
                  "  const visit = value => { if (value && typeof value === 'object') for (const [key, item] of Object.entries(value)) { pm.expect(['passwordHash', 'password', 'licenseNumber']).not.to.include(key); visit(item); } };",
                  "  visit(pm.response.json());",
                  "});",
                  "pm.test('Health', () => pm.expect(pm.response.json().message).to.eql('UrbanFix API funcionando'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Especialidades",
