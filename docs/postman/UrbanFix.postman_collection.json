              "raw": "{\n  \"name\": \"QA Cliente\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{registrationPassword}}\",\n  \"role\": \"CLIENT\",\n  \"phone\": \"+541143216543\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('allowRegistration') !== 'true' || !pm.environment.get('registrationEmail') || !pm.environment.get('registrationPassword')) pm.execution.skipRequest();"
                ]
